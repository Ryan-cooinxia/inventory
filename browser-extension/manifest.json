{
  "manifest_version": 3,
  "name": "电商商品采集器",
  "version": "1.0",
  "description": "一键采集1688/淘宝/天猫/拼多多商品信息到库存管理系统",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://www.ozon.by/*",
    "https://ozon.by/*",
    "https://www.ozon.kz/*",
    "https://ozon.kz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集商品信息",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://detail.1688.com/*",
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*",
        "https://detail.taobao.com/*",
        "https://h5.m.taobao.com/*",
        "https://m.taobao.com/*",
        "https://mobile.yangkeduo.com/*",
        "https://yangkeduo.com/*",
        "https://www.ozon.ru/product/*",
        "https://ozon.ru/product/*",
        "https://www.ozon.by/product/*",
        "https://ozon.by/product/*",
        "https://www.ozon.kz/product/*",
        "https://ozon.kz/product/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
